---
// Rodapé — referência: Max Pratt.
// Fica "por baixo" da página (sticky) e é revelado quando o conteúdo sobe.
// Faixa superior (período · nome · coordenadas), "Fale comigo" no centro, redes em pílulas.
// "Fale comigo" abre a gaveta de contato (ContactDrawer); sem JS, vira link de e-mail.
import { site, startYear } from '../data/site';

const { kicker, title, coords } = site.footer;
const year = new Date().getFullYear();
---

<footer id="contato" class="footer theme-dark">
  <div class="footer__row small">
    <p>Portfólio {startYear} — {year}</p>
    <p class="footer__center">{site.name}</p>
    <p class="footer__end">{coords}</p>
  </div>

  <div class="footer__hero">
    <p class="small muted">{kicker}</p>
    <a class="footer__cta" href={`mailto:${site.email}`} data-contact>{title}</a>
  </div>

  <div class="footer__row footer__row--bottom small">
    <p class="muted">© {year} {site.name}</p>
    <ul class="footer__socials footer__center">
      {site.socials.map((s) => <li><a class="pill-link" href={s.href}>{s.label}</a></li>)}
    </ul>
    <a class="link-line footer__end" href="#main">Voltar ao topo ↑</a>
  </div>
</footer>

<style>
  .footer {
    position: sticky;
    bottom: 0;
    z-index: 0;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    /* topo abaixo do menu em pílula, que é fixo e fica no centro */
    padding: 5.5rem var(--gutter) 2rem;
  }

  .footer__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }
  .footer__center {
    justify-self: center;
  }
  .footer__end {
    justify-self: end;
    text-align: right;
  }

  .footer__hero {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }
  /* Hover sutil: o texto só esmaece um pouco */
  .footer__cta {
    font-size: clamp(2rem, 1.2rem + 2.4vw, 3.5rem);
    font-weight: var(--fw-regular);
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    transition: opacity 0.5s var(--ease-out);
  }
  .footer__cta:hover,
  .footer__cta:focus-visible {
    opacity: 0.55;
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .pill-link {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--ink-3);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .pill-link:hover,
  .pill-link:focus-visible {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 767px) {
    .footer__row {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0.35rem;
    }
    .footer__center,
    .footer__end {
      justify-self: center;
      text-align: center;
    }
    .footer__row--bottom {
      gap: 1.25rem;
    }
    .footer__row--bottom > :first-child {
      order: 2;
    }
  }
</style>

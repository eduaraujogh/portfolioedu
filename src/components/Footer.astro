---
// Rodapé — síntese das referências:
// Jonas (frase em dois tons) · Rafa (e-mail gigante com letras que rolam no hover)
// Max Pratt (coordenadas) · Norwalk (info prática: aqui, horário local ao vivo)
// Exvia (colunas de links + nome gigante de ponta a ponta no fim).
import { site } from '../data/site';
import { withBase } from '../utils/url';
import SplitText from './SplitText.astro';

const { lead, rest, coords, timeZone } = site.footer;
const year = new Date().getFullYear();
const emailChars = [...site.email];
const nameChars = [...site.name];
---

<footer id="contato" class="footer theme-dark">
  <div class="footer__top grid">
    <p class="footer__label eyebrow muted" data-reveal>Contato</p>

    <div class="footer__main">
      <div class="footer__title">
        <SplitText as="h2" parts={[{ text: lead }, { text: rest, class: 'tone-2' }]} />
      </div>

      <div class="footer__mail" data-reveal>
        <a class="roll" href={`mailto:${site.email}`} aria-label={`Enviar e-mail para ${site.email}`}>
          {
            emailChars.map((c, i) => (
              <span class="roll__c" style={`--i:${i}`} aria-hidden="true">
                <span>{c}</span>
                <span>{c}</span>
              </span>
            ))
          }
        </a>
        <button class="footer__copy eyebrow" type="button" data-copy={site.email} hidden>
          Copiar
        </button>
      </div>
    </div>
  </div>

  <div class="footer__cols grid">
    <div class="footer__col footer__col--place" data-reveal>
      <p class="eyebrow muted">{site.location}</p>
      <p class="small">{coords}</p>
      <p class="small">
        <time class="footer__clock" data-tz={timeZone}>--:--</time>
        <span class="muted"> · horário local</span>
      </p>
    </div>

    <nav class="footer__col" aria-label="Rodapé" data-reveal style="--reveal-delay:0.06s">
      <p class="eyebrow muted">Navegação</p>
      <ul>
        {site.nav.map((item) => <li><a class="link-line" href={withBase(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col" data-reveal style="--reveal-delay:0.12s">
      <p class="eyebrow muted">Redes</p>
      <ul>
        {site.socials.map((s) => <li><a class="link-line" href={s.href}>{s.label}</a></li>)}
      </ul>
    </div>

    <div class="footer__col footer__col--end" data-reveal style="--reveal-delay:0.18s">
      <a class="link-line footer__top-link" href="#main">Voltar ao topo ↑</a>
    </div>
  </div>

  <div class="footer__legal grid small muted">
    <p>© {year} {site.name}</p>
    <p class="footer__legal-end">Todos os direitos reservados</p>
  </div>

  <!-- Nome gigante: ajustado por script para ocupar exatamente a largura -->
  <p class="footer__name split" data-reveal="split" aria-hidden="true">
    <span class="footer__name-inner">
      {
        nameChars.map((c, i) =>
          c === ' ' ? (
            ' '
          ) : (
            <span class="w">
              <span class="w__i" style={`--i:${i * 2}`}>{c}</span>
            </span>
          ),
        )
      }
    </span>
  </p>
</footer>

<script>
  // Horário local ao vivo
  document.querySelectorAll<HTMLTimeElement>('.footer__clock').forEach((el) => {
    const fmt = new Intl.DateTimeFormat('pt-BR', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: el.dataset.tz,
    });
    const tick = () => (el.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 15000);
  });

  // Copiar e-mail (só aparece se o navegador permitir)
  document.querySelectorAll<HTMLButtonElement>('.footer__copy').forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy!);
      btn.textContent = 'Copiado ✓';
      btn.classList.add('is-done');
      setTimeout(() => {
        btn.textContent = 'Copiar';
        btn.classList.remove('is-done');
      }, 2000);
    });
  });

  // Nome gigante: calcula o tamanho da fonte para caber exatamente na largura
  const name = document.querySelector<HTMLElement>('.footer__name');
  const inner = name?.querySelector<HTMLElement>('.footer__name-inner');
  if (name && inner) {
    const fit = () => {
      const cs = getComputedStyle(name);
      const avail = name.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      name.style.fontSize = '100px';
      const natural = inner.getBoundingClientRect().width; // largura real do texto a 100px
      name.style.fontSize = `${Math.floor((100 * avail) / natural * 100) / 100}px`;
    };
    document.fonts.ready.then(fit);
    addEventListener('resize', fit);
  }
</script>

<style>
  .footer {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--line);
  }

  /* Convite + e-mail */
  .footer__top {
    row-gap: var(--space-m);
    padding-top: var(--space-l);
  }
  .footer__label {
    grid-column: 1 / span 3;
    padding-top: 1.1rem;
  }
  .footer__main {
    grid-column: 5 / -1;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .footer__title {
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }

  .footer__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  /* E-mail com letras que rolam: cada letra tem uma cópia embaixo que sobe no hover */
  .roll {
    display: inline-flex;
    font-size: clamp(1.5rem, 0.6rem + 3vw, 4rem);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-lead);
    line-height: 1.1;
    padding-bottom: 0.15em;
    background: linear-gradient(var(--line), var(--line)) 0 100% / 100% 1px no-repeat;
  }
  .roll__c {
    display: inline-grid;
    overflow: clip;
    overflow-clip-margin: 0.05em;
    height: 1.1em;
  }
  .roll__c > span {
    grid-area: 1 / 1;
    transition: translate 0.55s var(--ease-out);
    transition-delay: calc(var(--i) * 14ms);
  }
  .roll__c > span:last-child {
    translate: 0 110%;
  }
  .roll:hover .roll__c > span:first-child,
  .roll:focus-visible .roll__c > span:first-child {
    translate: 0 -110%;
  }
  .roll:hover .roll__c > span:last-child,
  .roll:focus-visible .roll__c > span:last-child {
    translate: none;
  }

  .footer__copy {
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: none;
    color: var(--ink-2);
    cursor: pointer;
    font: inherit;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .footer__copy:hover,
  .footer__copy.is-done {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  /* Colunas */
  .footer__cols {
    row-gap: var(--space-m);
    padding-block: var(--space-l) var(--space-m);
  }
  .footer__col {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  .footer__col ul {
    display: grid;
    gap: 0.35rem;
  }
  .footer__col .eyebrow {
    margin-bottom: 0.4rem;
  }
  .footer__col--place {
    grid-column: 1 / span 3;
  }
  .footer__cols > :nth-child(2) {
    grid-column: 5 / span 2;
  }
  .footer__cols > :nth-child(3) {
    grid-column: 7 / span 2;
  }
  .footer__col--end {
    grid-column: 10 / -1;
    justify-items: end;
  }
  .footer__clock {
    font-variant-numeric: tabular-nums;
  }

  .footer__legal {
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    margin-inline: var(--gutter);
    padding-inline: 0;
  }
  .footer__legal > p {
    grid-column: 1 / span 6;
  }
  .footer__legal-end {
    grid-column: 7 / -1 !important;
    text-align: right;
  }

  /* Nome gigante de ponta a ponta, encostado na base */
  .footer__name {
    margin: 0;
    padding-inline: var(--gutter);
    font-size: 16vw; /* valor inicial; o script ajusta para caber exato */
    font-weight: var(--fw-medium);
    letter-spacing: -0.045em;
    line-height: 0.8;
    white-space: nowrap;
    color: var(--ink);
    margin-bottom: -0.02em;
    user-select: none;
  }
  .footer__name-inner {
    display: inline-block;
  }

  @media (max-width: 1023px) {
    .footer__label,
    .footer__main {
      grid-column: 1 / -1;
    }
    .footer__label {
      padding-top: 0;
    }
  }
  @media (max-width: 767px) {
    .footer__col--place {
      grid-column: 1 / -1;
    }
    .footer__cols > :nth-child(2) {
      grid-column: 1 / span 6;
    }
    .footer__cols > :nth-child(3) {
      grid-column: 7 / -1;
    }
    .footer__col--end {
      grid-column: 1 / -1;
      justify-items: start;
    }
    .footer__legal > p {
      grid-column: 1 / -1;
    }
    .footer__legal-end {
      grid-column: 1 / -1 !important;
      text-align: left;
    }
  }
</style>

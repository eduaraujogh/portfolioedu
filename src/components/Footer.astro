---
// Rodapé enxuto — três camadas:
// 1. Convite em dois tons (Jonas) + e-mail com letras que rolam no hover (Rafa)
// 2. Uma linha fina: © · redes · voltar ao topo
// 3. Nome gigante de ponta a ponta (Exvia)
import { site } from '../data/site';
import SplitText from './SplitText.astro';

const { lead, rest } = site.footer;
const year = new Date().getFullYear();
const emailChars = [...site.email];
const nameChars = [...site.name];
---

<footer id="contato" class="footer theme-dark">
  <div class="footer__top grid">
    <div class="footer__main">
      <div class="footer__title">
        <SplitText as="h2" parts={[{ text: lead }, { text: rest, class: 'tone-2' }]} />
      </div>

      <a class="roll" href={`mailto:${site.email}`} aria-label={`Enviar e-mail para ${site.email}`} data-reveal>
        {
          emailChars.map((c, i) => (
            <span class="roll__c" style={`--i:${i}`} aria-hidden="true">
              <span>{c}</span>
              <span>{c}</span>
            </span>
          ))
        }
      </a>
    </div>
  </div>

  <div class="footer__bar small">
    <p class="muted">© {year} {site.name}</p>
    <ul class="footer__socials">
      {site.socials.map((s) => <li><a class="link-line" href={s.href}>{s.label}</a></li>)}
    </ul>
    <a class="link-line footer__up" href="#main">Voltar ao topo ↑</a>
  </div>

  <!-- Nome gigante: ajustado por script para ocupar exatamente a largura -->
  <p class="footer__name split" data-reveal="split" aria-hidden="true">
    <span class="footer__name-inner">
      {
        nameChars.map((c, i) =>
          c === ' ' ? (
            ' '
          ) : (
            <span class="w">
              <span class="w__i" style={`--i:${i * 2}`}>{c}</span>
            </span>
          ),
        )
      }
    </span>
  </p>
</footer>

<script>
  // Nome gigante: calcula o tamanho da fonte para caber exatamente na largura
  const name = document.querySelector<HTMLElement>('.footer__name');
  const inner = name?.querySelector<HTMLElement>('.footer__name-inner');
  if (name && inner) {
    const fit = () => {
      const cs = getComputedStyle(name);
      const avail = name.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      name.style.fontSize = '100px';
      const natural = inner.getBoundingClientRect().width; // largura real do texto a 100px
      name.style.fontSize = `${Math.floor(((100 * avail) / natural) * 100) / 100}px`;
    };
    document.fonts.ready.then(fit);
    addEventListener('resize', fit);
  }
</script>

<style>
  .footer {
    position: relative;
    overflow: clip;
    border-top: 1px solid var(--line);
  }

  /* Convite + e-mail */
  .footer__top {
    padding-block: var(--space-l);
  }
  .footer__main {
    grid-column: 5 / -1;
    display: grid;
    justify-items: start;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .footer__title {
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }

  /* E-mail com letras que rolam: cada letra tem uma cópia embaixo que sobe no hover */
  .roll {
    display: inline-flex;
    font-size: clamp(1.5rem, 0.6rem + 3vw, 4rem);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-lead);
    line-height: 1.1;
    padding-bottom: 0.15em;
    background: linear-gradient(var(--line), var(--line)) 0 100% / 100% 1px no-repeat;
  }
  .roll__c {
    display: inline-grid;
    overflow: clip;
    overflow-clip-margin: 0.05em;
    height: 1.1em;
  }
  .roll__c > span {
    grid-area: 1 / 1;
    transition: translate 0.55s var(--ease-out);
    transition-delay: calc(var(--i) * 14ms);
  }
  .roll__c > span:last-child {
    translate: 0 110%;
  }
  .roll:hover .roll__c > span:first-child,
  .roll:focus-visible .roll__c > span:first-child {
    translate: 0 -110%;
  }
  .roll:hover .roll__c > span:last-child,
  .roll:focus-visible .roll__c > span:last-child {
    translate: none;
  }

  /* Linha fina */
  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-inline: var(--gutter);
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .footer__socials {
    display: flex;
    gap: 1.5rem;
  }

  /* Nome gigante de ponta a ponta, encostado na base */
  .footer__name {
    margin: 0;
    padding-inline: var(--gutter);
    font-size: 16vw; /* valor inicial; o script ajusta para caber exato */
    font-weight: var(--fw-medium);
    letter-spacing: -0.045em;
    line-height: 0.8;
    white-space: nowrap;
    color: var(--ink);
    margin-bottom: -0.02em;
    user-select: none;
  }
  .footer__name-inner {
    display: inline-block;
  }

  @media (max-width: 1023px) {
    .footer__main {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 767px) {
    .footer__bar {
      justify-content: flex-start;
    }
  }
</style>

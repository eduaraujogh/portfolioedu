---
// Cursor contextual: só existe sobre elementos com [data-cursor="Texto"].
// Não há cursor customizado no resto do site — ele aparece apenas quando indica uma ação.
// Só em dispositivos com mouse; em toque não é renderizado.
---

<div class="cursor" aria-hidden="true">
  <span class="cursor__label"></span>
</div>

<script>
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const el = document.querySelector<HTMLElement>('.cursor')!;
  const label = el.querySelector<HTMLElement>('.cursor__label')!;

  if (fine.matches) {
    document.documentElement.classList.add('has-cursor');

    let mx = -200, my = -200; // posição do mouse
    let x = mx, y = my; // posição desenhada (segue com atraso)
    let current: Element | null = null;

    const update = () => {
      const target = document.elementFromPoint(mx, my)?.closest('[data-cursor]') ?? null;
      if (target === current) return;
      current = target;
      if (target) label.textContent = target.getAttribute('data-cursor');
      el.classList.toggle('is-active', !!target);
    };

    addEventListener('pointermove', (e) => {
      mx = e.clientX;
      my = e.clientY;
      update();
    }, { passive: true });
    // O conteúdo passa por baixo do mouse ao rolar: reavalia o alvo.
    addEventListener('scroll', update, { passive: true });
    document.addEventListener('pointerleave', () => {
      current = null;
      el.classList.remove('is-active');
    });

    const tick = () => {
      const k = reduce.matches ? 1 : 0.2;
      x += (mx - x) * k;
      y += (my - y) * k;
      el.style.translate = `${x}px ${y}px`;
      requestAnimationFrame(tick);
    };
    tick();
  }
</script>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 6rem;
    height: 6rem;
    margin: -3rem 0 0 -3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(18, 18, 17, 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    pointer-events: none;
    scale: 0;
    transition: scale 0.45s var(--ease-out);
  }
  .cursor.is-active {
    scale: 1;
  }
  .cursor__label {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    text-align: center;
    line-height: 1.2;
    max-width: 5em;
  }

  /* Some o cursor nativo só onde o círculo o substitui */
  :global(.has-cursor [data-cursor]) {
    cursor: none;
  }

  @media (hover: none), (pointer: coarse) {
    .cursor {
      display: none;
    }
  }
</style>

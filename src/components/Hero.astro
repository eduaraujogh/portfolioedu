---
import { site } from '../data/site';
import SplitText from './SplitText.astro';
import { noWidow } from '../utils/text';

const { lead, rest, about } = site.hero;

const updated = new Date().toLocaleDateString('pt-BR').replaceAll('/', '.');
---

<section class="hero grid" aria-labelledby="hero-title">
  <div class="hero__title">
    <SplitText
      as="h1"
      id="hero-title"
      mode="load"
      parts={[{ text: lead }, { text: rest, class: 'tone-2' }]}
    />
  </div>

  <div class="hero__meta small">
    <p class="hero__about">{noWidow(about)}</p>
    <p class="hero__updated muted">
      <span>Atualizado em</span>
      <time>{updated}</time>
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 78svh;
    align-content: end;
    row-gap: var(--space-m);
    padding-top: 9rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Wrapper recebe grid e tipografia; o h1 do SplitText herda (reset em base.css) */
  .hero__title {
    grid-column: 5 / -1;
    grid-row: 1;
    max-width: 17em;
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }

  .hero__meta {
    grid-column: 1 / span 3;
    grid-row: 1;
    align-self: end;
    display: grid;
    gap: 0.75rem;
    max-width: 38ch;
  }
  .hero__about {
    text-wrap: pretty; /* evita palavra sozinha na última linha */
  }
  .hero__updated {
    display: flex;
    gap: 1rem;
    margin-top: var(--space-m);
  }

  /* Entrada: o título sobe palavra por palavra (SplitText); meta aparece depois */
  :global(.motion) .hero__meta {
    opacity: 0;
    animation: fade 1s var(--ease-out) 0.9s forwards;
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 1023px) {
    .hero__title {
      grid-column: 1 / -1;
    }
    .hero__meta {
      grid-column: 1 / span 6;
      grid-row: 2;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 88svh;
      padding-top: 7rem;
    }
    .hero__meta {
      grid-column: 1 / -1;
    }
  }
</style>

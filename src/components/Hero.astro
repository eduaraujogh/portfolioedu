---
import { site } from '../data/site';

const { lead, rest, about } = site.hero;

// Cada palavra sobe de dentro de uma máscara, em sequência.
const words = [
  ...lead.split(' ').map((w) => ({ w, tone: 'lead' })),
  ...rest.split(' ').map((w) => ({ w, tone: 'rest' })),
];

const updated = new Date().toLocaleDateString('pt-BR').replaceAll('/', '.');
---

<section class="hero grid" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero__title" aria-label={`${lead} ${rest}`}>
    {
      words.map(({ w, tone }, i) => (
        <>
          <span class={`w w--${tone}`} aria-hidden="true">
            <span class="w__i" style={`--i:${i}`}>{w}</span>
          </span>{' '}
        </>
      ))
    }
  </h1>

  <div class="hero__meta small">
    <p class="hero__about">{about}</p>
    <p class="hero__updated muted">
      <span>Atualizado em</span>
      <time>{updated}</time>
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 78svh;
    align-content: end;
    row-gap: var(--space-m);
    padding-top: 9rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero__title {
    grid-column: 5 / -1;
    grid-row: 1;
    max-width: 17em;
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }

  .w {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.12em; /* não corta acentos e descendentes */
    vertical-align: top;
  }
  .w__i {
    display: inline-block;
  }
  .w--rest {
    color: var(--ink-3);
  }

  .hero__meta {
    grid-column: 1 / span 3;
    grid-row: 1;
    align-self: end;
    display: grid;
    gap: 0.75rem;
    max-width: 38ch;
  }
  .hero__about {
    text-wrap: pretty; /* evita palavra sozinha na última linha */
  }
  .hero__updated {
    display: flex;
    gap: 1rem;
    margin-top: var(--space-m);
  }

  /* Entrada: palavras sobem da máscara; meta aparece depois */
  :global(.motion) .w__i {
    transform: translateY(110%);
    animation: rise 1.1s var(--ease-out) forwards;
    animation-delay: calc(0.15s + var(--i) * 45ms);
  }
  :global(.motion) .hero__meta {
    opacity: 0;
    animation: fade 1s var(--ease-out) 0.9s forwards;
  }
  @keyframes rise {
    to {
      transform: none;
    }
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 1023px) {
    .hero__title {
      grid-column: 1 / -1;
    }
    .hero__meta {
      grid-column: 1 / span 6;
      grid-row: 2;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: 88svh;
      padding-top: 7rem;
    }
    .hero__meta {
      grid-column: 1 / -1;
    }
  }
</style>

---
// Botão flutuante de WhatsApp (todas as páginas). Abre a conversa com a mensagem já escrita.
import { site } from '../data/site';

const href = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(site.whatsappText)}`;
---

<a class="wa" href={href} target="_blank" rel="noopener" aria-label="Conversar no WhatsApp">
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
    <path
      fill="currentColor"
      d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3Zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4a10.4 10.4 0 0 1-1.6-5.6C5.2 10 10 5.3 16 5.3s10.8 4.7 10.8 10.5S22 26.4 16 26.4Zm5.9-7.8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.1-.3-.2-.6-.3Z"
    />
  </svg>
  <span class="wa__label">Fale comigo</span>
</a>

<style>
  .wa {
    position: fixed;
    right: var(--gutter);
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 3.25rem;
    padding: 0 1.1rem 0 0.9rem;
    border-radius: var(--radius-pill);
    background: #25d366;
    color: #0b1b10;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    box-shadow: 0 10px 28px rgba(18, 18, 17, 0.22);
    transition: transform 0.4s var(--ease-out);
  }
  @media (hover: hover) {
    .wa:hover {
      transform: translateY(-3px);
    }
  }
  /* no celular vira só o ícone, acima do menu flutuante */
  @media (max-width: 767px) {
    .wa {
      bottom: calc(5.25rem + env(safe-area-inset-bottom));
      width: 3.25rem;
      padding: 0;
      justify-content: center;
    }
    .wa__label {
      display: none;
    }
  }
  @media print {
    .wa {
      display: none;
    }
  }
</style>

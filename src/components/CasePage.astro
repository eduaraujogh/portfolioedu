---
// Página de case — referências: Max Pratt (/cases: título + ficha técnica + capa grande + próximo
// projeto) e Maxx (/project: ficha Cliente/Serviço em linha). Textos e galeria: data/cases.ts.
// 1. Título + ficha · 2. Capa · 3. Desafio / Solução · 4. Galeria (uma cheia, dois pares)
// 5. Conceito · 6. Próximo projeto · CTA
// Case com capítulos (ex.: Artta): no lugar da galeria única entram um índice e um bloco por
// entrega (título, texto, resultado, decisões e galeria própria).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SplitText from './SplitText.astro';
import WorkCard from './WorkCard.astro';
import CaseGallery from './CaseGallery.astro';
import CaseResults from './CaseResults.astro';
import Cta from './Cta.astro';
import { site, coverOf, type Work } from '../data/site';
import { cases, itemsOf, nextOf } from '../data/cases';
import { withBase } from '../utils/url';
import { coverVideos } from '../data/videos';
import { noWidow, lower } from '../utils/text';

interface Props {
  work: Work;
  base?: string; // '' (portfólio) ou '/estudio'
  studio?: boolean;
}
const { work, base = '', studio = false } = Astro.props;
const data = cases[work.slug];
const next = nextOf(work.slug);
const index = site.works.findIndex((w) => w.slug === work.slug);
const pad = (n: number) => String(n).padStart(2, '0');

const meta = [
  { label: data.clientLabel ?? 'Cliente', value: data.client },
  ...(data.role ? [{ label: 'Papel', value: data.role }] : []),
  { label: 'Setor', value: work.sector },
  { label: 'Serviços', value: data.services },
];

const [challengeLabel, solutionLabel] = data.labels ?? ['O desafio', 'A solução'];
const texts = [
  { label: challengeLabel, text: data.challenge },
  { label: solutionLabel, text: data.solution },
].filter((t) => t.text);

const discipline = lower(work.discipline);
const sector = lower(work.sector);
const items = itemsOf(work.slug, data.shots);
const chapters = data.chapters ?? [];
const video = coverVideos[work.slug];
---

<BaseLayout
  studio={studio}
  title={`${work.name} — ${site.name}`}
  description={`${work.name}: ${discipline} para ${sector}. ${data.challenge ?? ''}`.trim()}
>
  <article class="cs">
    <header class="cs-head grid">
      <div class="cs-head__top small">
        <a class="link-line" href={withBase(`${base}/works`)}>← Todos os projetos</a>
        <span class="muted">{pad(index + 1)} / {pad(site.works.length)}</span>
      </div>

      <div class="cs-head__title">
        <SplitText as="h1" mode="load" parts={[
            { text: `${work.name},` },
            { text: `${discipline} para ${sector}.`, class: 'tone-2' },
          ]}
        />
      </div>

      <dl class="cs-meta" style={`--cols:${meta.length}`}>
        {
          meta.map((m, i) => (
            <div data-reveal style={`--reveal-delay:${0.25 + i * 0.06}s`}>
              <dt class="eyebrow muted">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="cs-cover" data-reveal="media">
      <Image
        src={coverOf(work.slug)}
        alt={`${work.name}, ${discipline} para ${sector}`}
        widths={[800, 1280, 1920]}
        sizes="100vw"
        loading="eager"
      />
      {
        video && (
          <video class="cs-cover__video" autoplay muted loop playsinline preload="auto" aria-label={video.alt}>
            <source src={withBase(`/videos/${work.slug}.mp4`)} type="video/mp4" />
          </video>
        )
      }
    </div>

    {
      texts.length > 0 && (
        <section class="cs-text grid" aria-label="Sobre o projeto">
          {texts.map((t) => (
            <div class="cs-text__row" data-reveal>
              <h2 class="eyebrow">{t.label}</h2>
              <p>{noWidow(t.text!)}</p>
            </div>
          ))}
        </section>
      )
    }

    {
      chapters.length > 0 && (
        <nav class="cs-index grid" aria-label="Neste case">
          <p class="cs-index__label eyebrow muted" data-reveal>Neste case</p>
          <ol class="cs-index__list">
            {chapters.map((c, i) => (
              <li data-reveal style={`--reveal-delay:${i * 0.06}s`}>
                <a href={`#${c.id}`}>
                  <span class="muted">{pad(i + 1)}</span>
                  <span class="cs-index__title">{c.title}</span>
                  <span class="cs-index__kicker muted">{c.kicker}</span>
                  <span aria-hidden="true">↓</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {
      chapters.map((c, i) => (
        <section id={c.id} class="cs-ch" aria-labelledby={`${c.id}-title`}>
          <header class="cs-ch__head grid">
            <p class="cs-ch__meta eyebrow" data-reveal>
              <span class="muted">{pad(i + 1)}</span>
              <span>{c.kicker}</span>
            </p>
            <h2 id={`${c.id}-title`} class="cs-ch__title" data-reveal>{noWidow(c.title)}</h2>
            <p class="cs-ch__text" data-reveal>{noWidow(c.text)}</p>
          </header>

          {c.result && (
            <div class="cs-result grid" data-reveal>
              <p class="cs-result__value">
                <span class="cs-result__from">{c.result.from}</span>
                <span class="cs-result__arrow" aria-label="para">→</span>
                <span>{c.result.to}</span>
              </p>
              <p class="cs-result__label muted">{c.result.label}</p>
            </div>
          )}

          {c.decisions && (
            <div class="cs-dec grid">
              <p class="cs-dec__label eyebrow muted" data-reveal>Decisões</p>
              <ol class="cs-dec__list">
                {c.decisions.map((d, j) => (
                  <li data-reveal style={`--reveal-delay:${j * 0.08}s`}>
                    <span class="eyebrow muted">{pad(j + 1)}</span>
                    <h3>{d.title}</h3>
                    <p class="small muted">{noWidow(d.text)}</p>
                  </li>
                ))}
              </ol>
            </div>
          )}

          <div class="cs-ch__gallery">
            <CaseGallery
              items={itemsOf(`${work.slug}/${c.id}`, c.shots)}
              alt={`${work.name}, ${c.title.toLowerCase()}`}
              label={`Imagens: ${c.title}`}
            />
          </div>
        </section>
      ))
    }

    {
      data.concept && chapters.length > 0 && (
        <section class="cs-concept grid" aria-labelledby="cs-concept-label-ch">
          <p id="cs-concept-label-ch" class="cs-concept__label eyebrow muted" data-reveal>
            Conceito
          </p>
          <div class="cs-concept__text">
            <SplitText as="p" parts={[{ text: `“${data.concept}”` }]} />
          </div>
        </section>
      )
    }

    {data.results && chapters.length > 0 && <CaseResults items={data.results} />}

    {
      data.closing && (
        <div class="cs-closing">
          <CaseGallery
            items={itemsOf(`${work.slug}/fim`, data.closing)}
            alt={`${work.name}, encerramento`}
            label="Encerramento"
          />
        </div>
      )
    }

    {
      items.length > 0 && (
        <div class="cs-gallery">
          <CaseGallery items={items} alt={`${work.name}, ${discipline}`} />
        </div>
      )
    }

    {
      data.concept && chapters.length === 0 && (
        <section class="cs-concept grid" aria-labelledby="cs-concept-label">
          <p id="cs-concept-label" class="cs-concept__label eyebrow muted" data-reveal>
            Conceito
          </p>
          <div class="cs-concept__text">
            <SplitText as="p" parts={[{ text: `“${data.concept}”` }]} />
          </div>
        </section>
      )
    }

    {data.results && chapters.length === 0 && <CaseResults items={data.results} />}

    <nav class="cs-next" aria-label="Próximo projeto">
      <div class="cs-next__head" data-reveal>
        <div class="cs-next__title">
          <span class="eyebrow muted">Próximo projeto</span>
          <a href={withBase(`${base}/works/${next.slug}`)}>{next.name}</a>
        </div>
        <a class="link-line small" href={withBase(`${base}/works`)}>Todos os projetos ({site.works.length}) ↗</a>
      </div>
      <WorkCard work={next} base={base} wide />
    </nav>
  </article>

  <Cta studio={studio} />
</BaseLayout>

<script>
  // Capa animada em loop. Com "reduzir movimento", fica no pôster. Se o navegador recusar tocar
  // de primeira, tenta de novo no primeiro toque/rolagem.
  const v = document.querySelector<HTMLVideoElement>('.cs-cover__video');
  if (v) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.autoplay = false;
      v.pause();
    } else {
      v.addEventListener('playing', () => v.classList.add('is-playing'));
      const play = () => { v.muted = true; v.play().catch(() => {}); };
      play();
      v.addEventListener('loadeddata', play);
      ['touchstart', 'pointerdown', 'scroll'].forEach((ev) => addEventListener(ev, play, { passive: true, once: true }));
    }
  }
</script>

<style>
  /* 1. Título + ficha técnica */
  .cs-head {
    row-gap: var(--space-m);
    padding-top: clamp(7rem, 16vh, 10rem);
    padding-bottom: var(--space-m);
  }
  .cs-head__top {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    font-variant-numeric: tabular-nums;
  }
  .cs-head__title {
    grid-column: 1 / -1;
    max-width: 16em;
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }
  .cs-meta {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    column-gap: var(--col-gap);
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .cs-meta > div {
    display: grid;
    gap: 0.4rem;
    padding-top: 1rem;
  }
  .cs-meta dd {
    margin: 0;
    font-size: 0.9375rem;
  }

  /* 2. Capa */
  .cs-cover {
    margin-inline: var(--gutter);
    overflow: clip;
    border-radius: var(--radius-media);
    aspect-ratio: 16 / 9;
    background: var(--line);
  }
  .cs-cover {
    position: relative;
  }
  .cs-cover__video {
    position: absolute;
    inset: 0;
    opacity: 0; /* só aparece quando estiver tocando; até lá, a imagem estática */
    transition: opacity 0.5s var(--ease-out);
  }
  .cs-cover__video.is-playing {
    opacity: 1;
  }
  .cs-cover__video::-webkit-media-controls,
  .cs-cover__video::-webkit-media-controls-start-playback-button {
    display: none !important;
  }
  .cs-cover :global(img),
  .cs-cover__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 3. Desafio / Solução: rótulo | texto (mesmo ritmo do "Como eu trabalho") */
  .cs-text {
    padding-block: var(--space-l);
  }
  .cs-text__row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .cs-text__row h2 {
    grid-column: 1 / span 3;
    padding-top: 0.55em;
  }
  .cs-text__row p {
    grid-column: 5 / -1;
    max-width: 30em;
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    line-height: var(--lh-lead);
    letter-spacing: var(--tracking-lead);
  }
  .cs-text__row + .cs-text__row p {
    color: var(--ink-2);
  }

  /* 4. Galeria (case sem capítulos) */
  .cs-gallery {
    margin-block: var(--col-gap) var(--space-l);
  }

  /* 4b. Índice dos capítulos */
  .cs-index {
    row-gap: var(--space-s);
    padding-bottom: var(--space-l);
  }
  .cs-index__label {
    grid-column: 1 / span 3;
    padding-top: 1.1rem;
  }
  .cs-index__list {
    grid-column: 5 / -1;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cs-index__list a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto 1.5rem;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s var(--ease-out);
  }
  .cs-index__list li:last-child a {
    border-bottom: 1px solid var(--line);
  }
  .cs-index__title {
    font-size: 1.25rem;
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-lead);
  }
  .cs-index__kicker {
    font-size: var(--fs-small);
  }
  @media (hover: hover) {
    .cs-index__list a:hover .cs-index__title {
      color: var(--ink-2);
    }
  }

  /* 4c. Capítulo */
  .cs-ch {
    display: grid;
    /* respiro entre texto, resultado, decisões e imagens do capítulo */
    gap: clamp(3rem, 2rem + 3vw, 5.5rem);
    padding-bottom: var(--space-l);
    scroll-margin-top: 5rem;
  }
  .cs-ch__head {
    row-gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    margin-inline: var(--gutter);
    padding-inline: 0;
  }
  .cs-ch__meta {
    grid-column: 1 / span 4;
    display: flex;
    gap: 1rem;
    padding-top: 0.9rem;
  }
  .cs-ch__title {
    grid-column: 5 / -1;
    text-wrap: balance;
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }
  .cs-ch__text {
    grid-column: 5 / -1;
    max-width: 30em;
    color: var(--ink-2);
    font-size: clamp(1.125rem, 0.95rem + 0.5vw, 1.375rem);
    line-height: 1.4;
  }

  /* Resultado: antes → depois */
  .cs-result {
    row-gap: 0.25rem;
  }
  .cs-result__value,
  .cs-result__label {
    grid-column: 5 / -1;
  }
  .cs-result__value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4em;
    font-size: var(--fs-stat);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
  }
  .cs-result__from {
    color: var(--ink-3);
    text-decoration: line-through;
    text-decoration-thickness: 0.06em;
  }
  .cs-result__arrow {
    color: var(--ink-3);
  }

  /* Decisões */
  .cs-dec__label {
    grid-column: 1 / span 4;
    padding-top: 1.1rem;
  }
  .cs-dec__list {
    grid-column: 5 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--col-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cs-dec__list li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .cs-dec__list h3 {
    font-size: 1.0625rem;
    font-weight: var(--fw-medium);
  }

  .cs-closing {
    padding-bottom: var(--space-l);
  }

  /* 5. Conceito */
  .cs-concept {
    row-gap: var(--space-m);
    padding-bottom: var(--space-l); /* o espaço de cima vem da galeria */
  }
  .cs-concept__label {
    grid-column: 1 / span 3;
    padding-top: 0.9em;
  }
  .cs-concept__text {
    grid-column: 5 / -1;
    max-width: 20em;
    font-size: clamp(1.75rem, 1rem + 2.2vw, 3rem);
    font-weight: var(--fw-medium);
    line-height: 1.15;
    letter-spacing: var(--tracking-display);
  }

  /* 6. Próximo projeto */
  .cs-next {
    display: grid;
    gap: 1rem;
    padding: 0 var(--gutter) var(--space-l);
  }
  .cs-next__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .cs-next__title {
    display: grid;
    gap: 0.5rem;
  }
  .cs-next__title a {
    font-size: var(--fs-lead);
    font-weight: var(--fw-medium);
    line-height: 1.1;
    letter-spacing: var(--tracking-lead);
  }

  @media (max-width: 1023px) {
    .cs-text__row h2,
    .cs-text__row p,
    .cs-concept__label,
    .cs-concept__text,
    .cs-index__label,
    .cs-index__list,
    .cs-ch__meta,
    .cs-ch__title,
    .cs-ch__text,
    .cs-result__value,
    .cs-result__label,
    .cs-dec__label,
    .cs-dec__list {
      grid-column: 1 / -1;
    }
    .cs-index__label,
    .cs-ch__meta,
    .cs-dec__label {
      padding-top: 0;
    }
    .cs-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1rem;
    }
    .cs-text__row {
      row-gap: 0.75rem;
    }
    .cs-text__row h2,
    .cs-concept__label {
      padding-top: 0;
    }
  }
  @media (max-width: 767px) {
    .cs-meta {
      grid-template-columns: 1fr;
    }
    .cs-cover {
      aspect-ratio: 4 / 3;
    }
    .cs-dec__list {
      grid-template-columns: 1fr;
    }
    .cs-index__list a {
      grid-template-columns: 2rem 1fr 1.25rem;
    }
    .cs-index__kicker {
      display: none;
    }
  }
</style>

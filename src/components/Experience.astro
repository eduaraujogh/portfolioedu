---
// Referência: lista "Awards & Recognitions" do Max Pratt (rótulo à esquerda, linhas finas).
// Cada linha abre com a descrição: no hover (mouse) ou no clique/toque/teclado.
// Uma aberta por vez; abrir e fechar acontecem juntos, então a lista não "pula" sob o mouse.
import { site } from '../data/site';

const { label, items } = site.experience;
---

<section id="experiencia" class="xp grid" aria-labelledby="xp-label">
  <h2 id="xp-label" class="xp__label eyebrow" data-reveal>{label}</h2>

  <ol class="xp__list">
    {
      items.map((item, i) => (
        <li class="xp__item" data-reveal style={`--reveal-delay:${i * 0.06}s`}>
          <button
            class="xp__head"
            type="button"
            aria-expanded="false"
            aria-controls={`xp-panel-${i}`}
          >
            <span class="xp__company">{item.company}</span>
            <span class="xp__role small muted">{item.role}</span>
            <span class="xp__period">{item.period}</span>
            <span class="xp__icon" aria-hidden="true" />
          </button>
          <div class="xp__panel" id={`xp-panel-${i}`} role="region" aria-label={item.company}>
            <div class="xp__panel-inner">
              <p class="xp__brands eyebrow muted">{item.brands}</p>
              <p class="xp__desc">{item.description}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<script>
  const list = document.querySelector<HTMLElement>('.xp__list');
  if (list) {
    const items = [...list.querySelectorAll<HTMLElement>('.xp__item')];
    const hover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    let timer: number | undefined;

    const open = (target: HTMLElement | null) => {
      items.forEach((item) => {
        const isOpen = item === target;
        item.classList.toggle('is-open', isOpen);
        item.querySelector('.xp__head')!.setAttribute('aria-expanded', String(isOpen));
      });
      list.classList.toggle('has-open', !!target);
    };

    items.forEach((item) => {
      const head = item.querySelector<HTMLElement>('.xp__head')!;
      head.addEventListener('click', () => open(item.classList.contains('is-open') ? null : item));
      if (hover) {
        // Pequena espera: passar o mouse rápido por cima não abre tudo em sequência
        item.addEventListener('pointerenter', () => {
          clearTimeout(timer);
          timer = window.setTimeout(() => open(item), 90);
        });
      }
    });

    if (hover) {
      list.addEventListener('pointerleave', () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => open(null), 150);
      });
    }
  }
</script>

<style>
  .xp {
    row-gap: var(--space-m);
    padding-block: var(--space-l);
    background: var(--paper);
    position: relative; /* fica por cima da foto fixa da seção anterior */
  }
  .xp__label {
    grid-column: 1 / span 3;
    padding-top: 1.6rem;
  }
  .xp__list {
    grid-column: 5 / -1;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .xp__item {
    border-bottom: 1px solid var(--line);
    transition: opacity 0.4s var(--ease-out);
  }
  /* Com uma linha aberta, as outras recuam para dar foco */
  .xp__list.has-open .xp__item:not(.is-open) {
    opacity: 0.4;
  }

  .xp__head {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    grid-template-areas:
      'company period icon'
      'role    period icon';
    align-items: baseline;
    column-gap: 1.5rem;
    padding-block: 1.5rem;
    cursor: pointer;
  }
  .xp__head:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }
  .xp__company {
    grid-area: company;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-lead);
    line-height: 1.2;
  }
  .xp__role {
    grid-area: role;
    margin-top: 0.25rem;
  }
  .xp__period {
    grid-area: period;
    align-self: center;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Ícone + que vira × */
  .xp__icon {
    grid-area: icon;
    align-self: center;
    position: relative;
    width: 12px;
    height: 12px;
    transition: rotate 0.5s var(--ease-out);
  }
  .xp__icon::before,
  .xp__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: currentColor;
  }
  .xp__icon::after {
    rotate: 90deg;
  }
  .is-open .xp__icon {
    rotate: 45deg;
  }

  /* Painel: anima a altura com grid-template-rows 0fr → 1fr */
  .xp__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s var(--ease-out);
  }
  .is-open .xp__panel {
    grid-template-rows: 1fr;
  }
  .xp__panel-inner {
    overflow: hidden;
    min-height: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 44em;
    opacity: 0;
    translate: 0 -6px;
    transition:
      opacity 0.4s var(--ease-out),
      translate 0.5s var(--ease-out),
      padding 0.6s var(--ease-out);
  }
  .is-open .xp__panel-inner {
    opacity: 1;
    translate: none;
    padding-bottom: 1.75rem;
    transition-delay: 0.08s;
  }
  .xp__desc {
    font-size: 1.0625rem;
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .xp__panel,
    .xp__panel-inner,
    .xp__icon,
    .xp__item {
      transition-duration: 0.01s;
    }
  }

  @media (max-width: 1023px) {
    .xp__label,
    .xp__list {
      grid-column: 1 / -1;
    }
    .xp__label {
      padding-top: 0;
    }
  }
  @media (max-width: 767px) {
    .xp__head {
      column-gap: 1rem;
      padding-block: 1.25rem;
    }
  }
</style>

---
import { site } from '../data/site';

const [first, ...others] = site.works;
---

<!-- Prévia provisória: serve para sentir o scroll e os reveals até os projetos reais chegarem. -->
<section class="works" aria-labelledby="works-title">
  <h2 id="works-title" class="visually-hidden">Trabalhos selecionados</h2>

  <article class="work work--wide">
    <div class="work__media" data-reveal="media">
      <div class="work__placeholder" style={`--tone:${first.tone}`}>
        <span class="small">Imagem do projeto</span>
      </div>
    </div>
    <footer class="work__info small" data-reveal>
      <h3>{first.client}</h3>
      <p class="muted">{first.brands}</p>
      {first.year && <p class="muted">{first.year}</p>}
    </footer>
  </article>

  <div class="works__row">
    {
      others.map((work, i) => (
        <article class="work">
          <div class="work__media" data-reveal="media" style={`--reveal-delay:${i * 0.12}s`}>
            <div class="work__placeholder" style={`--tone:${work.tone}`}>
              <span class="small">Imagem do projeto</span>
            </div>
          </div>
          <footer class="work__info small" data-reveal style={`--reveal-delay:${i * 0.12}s`}>
            <h3>{work.client}</h3>
            <p class="muted">{work.brands}</p>
            {work.year && <p class="muted">{work.year}</p>}
          </footer>
        </article>
      ))
    }
  </div>
</section>

<style>
  .works {
    display: grid;
    gap: var(--space-l);
    padding: 0 var(--gutter) var(--space-l);
  }
  .works__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--col-gap);
  }
  .work {
    display: grid;
    gap: 0.875rem;
  }
  .work__media {
    overflow: clip;
    border-radius: var(--radius-media);
  }
  .work__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: var(--tone);
    color: var(--ink-2);
  }
  .work--wide .work__placeholder {
    aspect-ratio: 16 / 8;
  }
  .work__info {
    display: flex;
    gap: 1.5rem;
  }
  .work__info h3 {
    font-size: inherit;
    font-weight: var(--fw-medium);
  }
  .work__info p:last-child {
    margin-left: auto;
  }

  @media (max-width: 767px) {
    .works__row {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
    .work--wide .work__placeholder {
      aspect-ratio: 4 / 5;
    }
    .work__info {
      flex-wrap: wrap;
      column-gap: 1rem;
      row-gap: 0;
    }
  }
</style>

---
import { site } from '../data/site';
import WorkCard from './WorkCard.astro';

const [first, ...others] = site.works;
---

<!-- Prévia provisória: serve para sentir o scroll, os reveals e o hover até os projetos reais chegarem. -->
<section class="works" aria-labelledby="works-title">
  <h2 id="works-title" class="visually-hidden">Trabalhos selecionados</h2>

  <WorkCard {...first} wide />

  <div class="works__row">
    {others.map((work, i) => <WorkCard {...work} delay={i * 0.12} />)}
  </div>
</section>

<style>
  .works {
    display: grid;
    gap: var(--space-l);
    padding: 0 var(--gutter) var(--space-l);
  }
  .works__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--col-gap);
  }

  @media (max-width: 767px) {
    .works__row {
      grid-template-columns: 1fr;
      gap: var(--space-m);
    }
  }
</style>

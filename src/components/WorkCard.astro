---
// Card de projeto. Referência: Max Pratt.
// Com mouse: o card recua levemente, as informações aparecem sobre a imagem
// e o cursor vira um círculo "Ver projeto" (ver Cursor.astro).
// Em telas de toque (sem hover): as informações ficam sempre visíveis abaixo da imagem.
import { withBase } from '../utils/url';

interface Props {
  client: string;
  brands: string;
  year?: string;
  tone: string;
  href?: string;
  wide?: boolean;
  delay?: number;
}

const { client, brands, year, tone, href = '/works', wide = false, delay = 0 } = Astro.props;
---

<article class:list={['work', { 'work--wide': wide }]}>
  <a class="work__link" href={withBase(href)} data-cursor="Ver projeto">
    <div class="work__card">
      <div class="work__media" data-reveal="media" style={`--reveal-delay:${delay}s`}>
        <div class="work__placeholder" style={`--tone:${tone}`}>
          <span class="small">Imagem do projeto</span>
        </div>
      </div>

      <div class="work__tags" aria-hidden="true">
        <span class="tag">{client}</span>
        <span class="work__tags-end">
          <span class="tag">{brands}</span>
          {year && <span class="tag">{year}</span>}
        </span>
      </div>
    </div>

    <div class="work__info small" data-reveal style={`--reveal-delay:${delay}s`}>
      <h3>{client}</h3>
      <p class="muted">{brands}</p>
      {year && <p class="muted">{year}</p>}
    </div>
  </a>
</article>

<style>
  .work__link {
    display: grid;
    gap: 0.875rem;
  }

  .work__card {
    position: relative;
    overflow: clip;
    border-radius: var(--radius-media);
    transition:
      transform 0.7s var(--ease-out),
      border-radius 0.7s var(--ease-out);
  }

  .work__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background: var(--tone);
    color: var(--ink-2);
  }
  .work--wide .work__placeholder {
    aspect-ratio: 16 / 8;
  }

  /* Informações sobre a imagem (só em dispositivos com mouse) */
  .work__tags {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    padding: clamp(0.75rem, 1.5vw, 1.25rem);
    pointer-events: none;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.45s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .work__tags-end {
    display: flex;
    gap: 0.375rem;
  }
  /* Pílula escura translúcida: legível sobre qualquer imagem */
  .tag {
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(18, 18, 17, 0.42);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    font-size: var(--fs-small);
    line-height: 1;
    white-space: nowrap;
  }

  .work__info {
    display: flex;
    gap: 1.5rem;
  }
  .work__info h3 {
    font-weight: var(--fw-medium);
  }
  .work__info p:last-child {
    margin-left: auto;
  }

  @media (hover: hover) and (pointer: fine) {
    .work__info {
      display: none;
    }
    .work__link:hover .work__card,
    .work__link:focus-visible .work__card {
      transform: scale(0.97);
      border-radius: calc(var(--radius-media) * 2.5);
    }
    .work__link:hover .work__tags,
    .work__link:focus-visible .work__tags {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work__card,
    .work__tags {
      transition-duration: 0.01s;
    }
  }

  @media (max-width: 767px) {
    .work--wide .work__placeholder {
      aspect-ratio: 4 / 5;
    }
    .work__info {
      flex-wrap: wrap;
      column-gap: 1rem;
      row-gap: 0;
    }
  }
</style>

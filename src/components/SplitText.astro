---
// Texto que entra palavra por palavra, subindo de dentro de uma máscara.
// mode="load": anima ao carregar a página (hero).
// mode="scroll": anima quando entra na tela (seções).
// Estilos em styles/base.css (.split).

interface Part {
  text: string;
  class?: string;
}

interface Props {
  parts: Part[];
  as?: 'h1' | 'h2' | 'h3' | 'p';
  mode?: 'load' | 'scroll';
  class?: string;
  id?: string;
}

const { parts, as: Tag = 'p', mode = 'scroll', class: className = '', id } = Astro.props;

let i = 0;
const words = parts.flatMap((part) =>
  part.text.split(' ').map((w) => ({ w, cls: part.class ?? '', i: i++ })),
);

// Evita palavra sozinha na última linha: as duas últimas palavras viram um bloco só
// (cada palavra é inline-block, então text-wrap: pretty não consegue agir).
if (words.length > 2) {
  const last = words.pop()!;
  const prev = words[words.length - 1];
  if (prev.cls === last.cls) prev.w = `${prev.w} ${last.w}`;
  else words.push(last);
}
const label = parts.map((p) => p.text).join(' ');
---

<Tag
  id={id}
  class={`split split--${mode} ${className}`}
  aria-label={label}
  data-reveal={mode === 'scroll' ? 'split' : undefined}
>
  {
    words.map(({ w, cls, i }) => (
      <>
        <span class={`w ${cls}`} aria-hidden="true">
          <span class="w__i" style={`--i:${i}`}>{w}</span>
        </span>{' '}
      </>
    ))
  }
</Tag>

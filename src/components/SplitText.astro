---
// Texto que entra palavra por palavra, subindo de dentro de uma máscara.
// mode="load": anima ao carregar a página (hero).
// mode="scroll": anima quando entra na tela (seções).
// Uma parte pode ser um ícone em vez de texto ({ icon: 'wave' }).
// Estilos em styles/base.css (.split).
import WaveHand from './WaveHand.astro';

type Part = { text: string; class?: string } | { icon: 'wave' };

interface Props {
  parts: Part[];
  as?: 'h1' | 'h2' | 'h3' | 'p';
  mode?: 'load' | 'scroll';
  class?: string;
  id?: string;
}

const { parts, as: Tag = 'p', mode = 'scroll', class: className = '', id } = Astro.props;

type Token = { w: string; cls: string; i: number } | { icon: 'wave'; i: number };
const isWord = (t: Token): t is { w: string; cls: string; i: number } => 'w' in t;

let i = 0;
const tokens: Token[] = parts.flatMap((part): Token[] =>
  'icon' in part
    ? [{ icon: part.icon, i: i++ }]
    : part.text.split(' ').map((w) => ({ w, cls: part.class ?? '', i: i++ })),
);

// Palavras de uma letra ("à", "e", "a", "o") não ficam soltas no fim da linha:
// descem junto com a palavra seguinte.
for (let k = tokens.length - 2; k >= 0; k--) {
  const [cur, next] = [tokens[k], tokens[k + 1]];
  if (isWord(cur) && isWord(next) && cur.w.length === 1 && cur.cls === next.cls) {
    cur.w = `${cur.w} ${next.w}`;
    tokens.splice(k + 1, 1);
  }
}

// Evita palavra sozinha na última linha: as duas últimas palavras viram um bloco só
// (cada palavra é inline-block, então text-wrap: pretty não consegue agir).
const [prev, last] = tokens.slice(-2);
if (tokens.length > 2 && isWord(prev) && isWord(last) && prev.cls === last.cls) {
  prev.w = `${prev.w} ${last.w}`;
  tokens.pop();
}

const label = parts.flatMap((p) => ('text' in p ? [p.text] : [])).join(' ');
---

<Tag
  id={id}
  class={`split split--${mode} ${className}`}
  aria-label={label}
  data-reveal={mode === 'scroll' ? 'split' : undefined}
>
  {
    tokens.map((t) =>
      isWord(t) ? (
        <>
          <span class={`w ${t.cls}`} aria-hidden="true">
            <span class="w__i" style={`--i:${t.i}`}>{t.w}</span>
          </span>{' '}
        </>
      ) : (
        <>
          <WaveHand i={t.i} />{' '}
        </>
      ),
    )
  }
</Tag>

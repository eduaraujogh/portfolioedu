---
// Quem cuida do projeto: pessoal e direto, sem empresas nem formação.
import { Image } from 'astro:assets';
import { studio } from '../../data/studio';
import SplitText from '../SplitText.astro';
import { noWidow } from '../../utils/text';

const { label, lead, rest, text, stats } = studio.about;
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/me/portrait.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;
---

<section class="sa grid" aria-labelledby="sa-label">
  <h2 id="sa-label" class="sa__label eyebrow" data-reveal>{label}</h2>
  {
    photo && (
      <div class="sa__photo" data-reveal="media">
        <Image src={photo} alt="Eduardo Araújo" widths={[480, 800, 1200]} sizes="(max-width: 1023px) 100vw, 30vw" />
      </div>
    )
  }
  <div class="sa__body">
    <div class="sa__lead">
      <SplitText as="p" parts={[{ text: lead }, { text: rest, class: 'tone-2' }]} />
    </div>
    <div class="sa__text">
      {text.map((p, i) => <p data-reveal style={`--reveal-delay:${i * 0.05}s`}>{noWidow(p)}</p>)}
    </div>
    <dl class="sa__stats">
      {
        stats.map((s, i) => (
          <div data-reveal style={`--reveal-delay:${i * 0.06}s`}>
            <dt>{s.value}</dt>
            <dd class="small muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .sa {
    row-gap: var(--space-m);
    align-items: start;
    padding-block: var(--space-l);
  }
  .sa__label {
    grid-column: 1 / -1;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .sa__photo {
    grid-column: 1 / span 4;
    overflow: hidden;
    border-radius: var(--radius-media);
    aspect-ratio: 4 / 5;
  }
  .sa__photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .sa__body {
    grid-column: 6 / -1;
    display: grid;
    gap: var(--space-m);
  }
  .sa__lead {
    max-width: 18em;
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }
  .sa__text {
    display: grid;
    gap: 1rem;
    max-width: 36em;
    color: var(--ink-2);
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .sa__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--col-gap);
    margin: 0;
  }
  .sa__stats > div {
    display: grid;
    gap: 0.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .sa__stats dt {
    font-size: var(--fs-stat);
    font-weight: var(--fw-medium);
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }
  .sa__stats dd {
    margin: 0;
  }
  @media (max-width: 1023px) {
    .sa__photo,
    .sa__body {
      grid-column: 1 / -1;
    }
    .sa__photo {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 767px) {
    .sa__stats {
      grid-template-columns: 1fr;
    }
  }
</style>

---
// Perguntas frequentes em acordeão nativo (<details>), sem JS.
import { studio } from '../../data/studio';
import { noWidow } from '../../utils/text';

const { label, items } = studio.faq;
---

<section class="fq grid" aria-labelledby="fq-label">
  <h2 id="fq-label" class="fq__label eyebrow" data-reveal>{label}</h2>
  <div class="fq__list">
    {
      items.map((it, i) => (
        <details data-reveal style={`--reveal-delay:${i * 0.05}s`}>
          <summary>
            <span>{it.q}</span>
            <span class="fq__icon" aria-hidden="true" />
          </summary>
          <p>{noWidow(it.a)}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .fq {
    row-gap: var(--space-m);
    padding-block: var(--space-l);
  }
  .fq__label {
    grid-column: 1 / span 3;
    padding-top: 1.6rem;
  }
  .fq__list {
    grid-column: 5 / -1;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tracking-lead);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .fq__icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .fq__icon::before,
  .fq__icon::after {
    content: '';
    position: absolute;
    inset: 6px 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }
  .fq__icon::after {
    transform: rotate(90deg);
  }
  details[open] .fq__icon::after {
    transform: rotate(0deg);
  }
  details p {
    max-width: 38em;
    padding-bottom: 1.5rem;
    color: var(--ink-2);
    line-height: 1.6;
  }
  @media (max-width: 1023px) {
    .fq__label,
    .fq__list {
      grid-column: 1 / -1;
    }
    .fq__label {
      padding-top: 0;
    }
  }
</style>

---
// Mãozinha que acena ao passar o mouse (ou tocar). Traço na cor do texto.
// Ícone: "hand" do Lucide (licença ISC).
interface Props {
  i?: number; // posição na sequência do SplitText, para entrar junto com as palavras
}
const { i = 0 } = Astro.props;
---

<span class="wave" style={`--i:${i}`} aria-hidden="true">
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"></path>
    <path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"></path>
    <path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"></path>
    <path
      d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"
    ></path>
  </svg>
</span>

<style>
  .wave {
    display: inline-block;
    width: 0.97em;
    height: 0.97em;
    /* padding aumenta a área de hover; margens negativas compensam para não abrir espaço
       e mantêm a mão alinhada à margem do texto */
    padding: 0.1em;
    margin: -0.1em -0.06em -0.1em -0.12em;
    box-sizing: content-box;
    vertical-align: -0.2em;
  }
  .wave svg {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 70% 85%; /* pulso */
  }

  /* Aceno: balança rápido e assenta devagar, uma vez por passada do mouse */
  .wave:hover svg,
  .wave:active svg {
    animation: wave-hand 1.3s cubic-bezier(0.36, 0, 0.2, 1);
  }
  @keyframes wave-hand {
    0% { rotate: 0deg; }
    12% { rotate: 16deg; }
    26% { rotate: -9deg; }
    40% { rotate: 14deg; }
    54% { rotate: -5deg; }
    68% { rotate: 8deg; }
    100% { rotate: 0deg; }
  }

  /* Entra junto com as palavras do SplitText (sem máscara, para o aceno não ser cortado) */
  :global(.js-reveal [data-reveal='split']) .wave {
    opacity: 0;
    translate: 0 0.3em;
    transition:
      opacity 0.9s var(--ease-out),
      translate 1.1s var(--ease-out);
    transition-delay: calc(var(--i) * 16ms);
  }
  :global(.js-reveal [data-reveal='split'].is-in) .wave {
    opacity: 1;
    translate: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .wave:hover svg,
    .wave:active svg {
      animation: none;
    }
  }
</style>

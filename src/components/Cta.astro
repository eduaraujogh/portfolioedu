---
// Chamada final antes do rodapé — referência: Norwalk (pergunta grande + pessoa de contato).
// O avatar com nome e cargo é o próprio link de contato.
import { Image } from 'astro:assets';
import { site } from '../data/site';
import SplitText from './SplitText.astro';

const { lead, rest, role } = site.cta;

// Recorte quadrado já centralizado no rosto (gerado a partir de portrait.webp)
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/me/avatar.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;
---

<section class="cta grid" aria-labelledby="cta-title">
  <div class="cta__inner">
    <div class="cta__title">
      <SplitText as="h2" id="cta-title" parts={[{ text: lead }, { text: rest, class: 'tone-2' }]} />
    </div>

    <a class="person" href={`mailto:${site.email}`} data-contact data-reveal style="--reveal-delay:0.2s">
      <span class="person__avatar">
        {photo && <Image src={photo} alt="" widths={[160, 320]} sizes="160px" />}
      </span>
      <span class="person__text">
        <span class="person__name">{site.name}</span>
        <span class="person__role">
          {role}
          <span class="person__arrow" aria-hidden="true">↗</span>
        </span>
      </span>
    </a>
  </div>
</section>

<style>
  .cta {
    padding-block: calc(var(--space-l) * 1.5) var(--space-l);
    background: var(--paper);
    position: relative;
  }
  .cta__inner {
    grid-column: 1 / span 8;
    display: grid;
    justify-items: start;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }
  .cta__title {
    font-size: var(--fs-display);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
  }

  .person {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
  }
  .person__avatar {
    width: clamp(3.5rem, 5vw, 4.75rem);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--line);
    flex: none;
  }
  .person__avatar :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.7s var(--ease-out);
  }
  .person__text {
    display: grid;
    gap: 0.1rem;
    font-size: 1rem;
    line-height: 1.3;
  }
  .person__name {
    font-weight: var(--fw-medium);
  }
  .person__role {
    color: var(--ink-3);
  }
  .person__arrow {
    display: inline-block;
    margin-left: 0.25rem;
    opacity: 0;
    translate: -4px 4px;
    transition:
      opacity 0.4s var(--ease-out),
      translate 0.4s var(--ease-out);
  }
  .person:hover .person__avatar :global(img),
  .person:focus-visible .person__avatar :global(img) {
    scale: 1.08;
  }
  .person:hover .person__arrow,
  .person:focus-visible .person__arrow {
    opacity: 1;
    translate: none;
  }

  @media (max-width: 1023px) {
    .cta__inner {
      grid-column: 1 / -1;
    }
  }
</style>

---
// Foto em tela cheia. Dois efeitos combinados:
// 1. Revelação em "janela" (ref. Norwalk): a moldura rola, a foto fica presa à tela
//    (position: fixed recortada pelo clip-path da seção) e sobe devagar (parallax).
// 2. Visor de foco (ref. Exvia): a foto aparece desfocada e um quadrado nítido segue o mouse.
//    Sem mouse (toque), o visor fica parado no centro.
//
// Para trocar a foto: substitua src/assets/me/portrait.(jpg|png|webp).
// Se a nova foto tiver o rosto em outro lugar, ajuste FOCUS_X/FOCUS_Y no script abaixo.
import { Image } from 'astro:assets';
import { site } from '../data/site';

const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/me/portrait.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photo = Object.values(photos)[0]?.default;
---

<section class="portrait" aria-label="Foto de Eduardo Araújo">
  <div class="portrait__pin">
    {
      photo ? (
        <div class="portrait__layer">
          {/* Camada desfocada: versão pequena já basta, o blur esconde a resolução */}
          <Image
            class="portrait__img portrait__img--blur"
            src={photo}
            alt=""
            aria-hidden="true"
            widths={[800, 1280]}
            sizes="100vw"
          />
          <Image
            class="portrait__img portrait__img--sharp"
            src={photo}
            alt="Eduardo Araújo"
            widths={[768, 1280, 1920, 2400]}
            sizes="100vw"
          />
        </div>
      ) : (
        <div class="portrait__placeholder">
          <span class="eyebrow">Sua foto aqui · src/assets/me/portrait.jpg</span>
        </div>
      )
    }
    <div class="portrait__lens" aria-hidden="true"></div>

    <div class="portrait__cta">
      <h2 class="portrait__title">{site.portrait.title}</h2>
      <a class="portrait__link" href={`mailto:${site.email}`}>{site.portrait.cta} ↗</a>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.portrait');
  const layer = section?.querySelector<HTMLElement>('.portrait__layer');
  const sharp = section?.querySelector<HTMLElement>('.portrait__img--sharp');
  const lens = section?.querySelector<HTMLElement>('.portrait__lens');

  // Onde o visor fica quando o mouse não está sobre a foto (fração da tela). Ajustado ao rosto.
  const FOCUS_X = 0.52;
  const FOCUS_Y = 0.3;

  if (section && layer && sharp && lens) {
    const motionOk = document.documentElement.classList.contains('motion');
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

    let visible = false;
    let hovering = false;
    let mx = innerWidth * FOCUS_X, my = innerHeight * FOCUS_Y; // alvo do visor
    let lx = mx, ly = my; // posição desenhada (segue com atraso)

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) requestAnimationFrame(tick);
    }).observe(section);

    if (finePointer) {
      section.addEventListener('pointermove', (e) => {
        hovering = true;
        mx = e.clientX;
        my = e.clientY;
      });
      section.addEventListener('pointerleave', () => (hovering = false));
    }

    function tick() {
      if (!visible) return;

      // Parallax: a foto sobe mais devagar que a moldura
      if (motionOk) {
        const r = section!.getBoundingClientRect();
        const p = (innerHeight - r.top) / (innerHeight + r.height);
        layer!.style.translate = `0 ${(0.5 - p) * 16}%`;
      }

      // Visor: segue o mouse; sem mouse, repousa sobre o rosto (ponto de foco da foto)
      const tx = hovering ? mx : innerWidth * FOCUS_X;
      const ty = hovering ? my : Math.max(innerHeight * FOCUS_Y, lens!.offsetWidth / 2 + 16);
      const k = motionOk ? 0.12 : 1;
      lx += (tx - lx) * k;
      ly += (ty - ly) * k;

      const size = lens!.offsetWidth;
      const half = size / 2;
      lens!.style.translate = `${lx - half}px ${ly - half}px`;

      // Recorta a camada nítida exatamente na área do visor (coordenadas da imagem)
      const ir = sharp!.getBoundingClientRect();
      const top = ly - half - ir.top;
      const left = lx - half - ir.left;
      sharp!.style.clipPath = `inset(${top}px ${ir.width - left - size}px ${ir.height - top - size}px ${left}px)`;

      requestAnimationFrame(tick);
    }
  }
</script>

<style>
  .portrait {
    position: relative;
    height: 100svh;
    clip-path: inset(0); /* recorta o conteúdo fixo: é a "janela" */
    background: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .portrait {
      cursor: none; /* a cruz do visor faz o papel de cursor */
    }
  }

  .portrait__pin {
    position: fixed;
    inset: 0;
    overflow: hidden;
  }
  .portrait__layer {
    position: absolute;
    inset: 0 0 -16%; /* folga só embaixo: no fim do parallax o topo da foto encosta no topo da tela */
    will-change: translate;
  }
  .portrait__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top; /* preserva a cabeça quando a foto é cortada */
  }
  .portrait__img--blur {
    filter: blur(6px) brightness(0.85);
    transform: scale(1.04); /* esconde a borda clara que o blur cria */
  }

  /* Texto no canto superior; o degradê existe só para garantir leitura sobre a foto */
  .portrait__cta {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    padding: clamp(5.5rem, 12vh, 8rem) var(--gutter) 6rem;
    background: linear-gradient(rgba(0, 0, 0, 0.45), transparent);
    color: #fff;
  }
  .portrait__title {
    max-width: 13em;
    font-size: clamp(2rem, 1rem + 3vw, 3.5rem);
    font-weight: var(--fw-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }
  /* Link discreto: texto pequeno com sublinhado fino que some e volta no hover */
  .portrait__link {
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.85);
    padding-bottom: 2px;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    cursor: pointer;
    transition:
      background-size 0.5s var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .portrait__link:hover {
    color: #fff;
    background-size: 0 1px;
    background-position: 100% 100%;
  }
  .portrait__link:focus-visible {
    outline-color: #fff;
  }
  /* Visor: moldura fina + cruz central */
  .portrait__lens {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: clamp(14rem, 30vw, 32rem);
    aspect-ratio: 1;
    border: 1px solid rgba(255, 255, 255, 0.35);
    pointer-events: none;
    will-change: translate;
  }
  .portrait__lens::before,
  .portrait__lens::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: rgba(255, 255, 255, 0.8);
    translate: -50% -50%;
  }
  .portrait__lens::before {
    width: 11px;
    height: 1px;
  }
  .portrait__lens::after {
    width: 1px;
    height: 11px;
  }

  .portrait__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: radial-gradient(60% 70% at 50% 40%, #3a3935 0%, #1a1a18 70%);
    color: rgba(255, 255, 255, 0.55);
  }
  .portrait__placeholder ~ .portrait__lens {
    display: none;
  }
</style>

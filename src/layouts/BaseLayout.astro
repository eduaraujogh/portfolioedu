---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDrawer from '../components/ContactDrawer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  studio?: boolean; // versão estúdio (/estudio)
}

const {
  title = `${site.name} — ${site.role}`,
  description = `${site.hero.lead} ${site.hero.rest}`,
  studio = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('/og.jpg'), Astro.site).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <!-- Prévia ao compartilhar o link (WhatsApp, LinkedIn, Instagram…) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3f2ef" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500&display=swap"
    />
    <!-- Liga as animações antes do primeiro paint, só se o usuário não pediu movimento reduzido -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion');
      }
    </script>
  </head>
  <body>
    <a class="skip small" href="#main">Pular para o conteúdo</a>
    <Header studio={studio} />
    <main id="main">
      <slot />
    </main>
    <Footer studio={studio} />
    <ContactDrawer />
    <WhatsAppButton />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 100;
    padding: 0.5rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    transform: translateY(-200%);
  }
  .skip:focus-visible {
    transform: none;
  }
</style>

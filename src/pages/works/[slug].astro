---
// Página de case do portfólio. O conteúdo vive em components/CasePage.astro (compartilhado com /estudio).
import CasePage from '../../components/CasePage.astro';
import { site, type Work } from '../../data/site';

export function getStaticPaths() {
  return site.works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
const { work } = Astro.props as { work: Work };
---

<CasePage work={work} />

---
// Currículo em uma página A4, no estilo do site e com os mesmos dados (data/site.ts).
// Gera o PDF com: npm run curriculo  →  public/curriculo-eduardo-araujo.pdf
// Página fora do menu e fora dos buscadores; serve de fonte para o PDF.
// Estrutura espelha o site: faixa do header · frase em dois tons · lateral com listas +
// linhas de Experiência/Formação (About) · faixa escura no fim, como o rodapé.
import { Image } from 'astro:assets';
import { site, startYear } from '../data/site';
import { cv } from '../data/cv';
import { noWidow } from '../utils/text';
import '../styles/tokens.css';

const year = new Date().getFullYear();
const years = year - startYear;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
// Versão do portfólio feita para recrutadores (a raiz do site é a versão estúdio)
const portfolioUrl = siteUrl.replace(/\/?$/, '/') + 'portfolio/';
const pretty = (url: string) => decodeURI(url).replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const { skills, tools, ai, languages } = cv;
const social = (label: string) => site.socials.find((s) => s.label === label)!.href;

const contacts = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', href: social('LinkedIn') },
  { label: 'Behance', href: social('Behance') },
];

const avatars = import.meta.glob<{ default: ImageMetadata }>('../assets/me/avatar.{jpg,jpeg,png,webp}', { eager: true });
const avatar = Object.values(avatars)[0]?.default;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Currículo — {site.name}</title>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500&display=block" />
  </head>
  <body>
    <main class="sheet">
      <div class="paper">
        <!-- Faixa superior (header do site) -->
        <header class="top">
          <div class="top__id">
            <strong>{site.name}</strong>
            <span class="muted">{site.role} · {site.location}</span>
          </div>
          <span class="top__pill">Currículo</span>
          <ul class="top__links">
            {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          </ul>
        </header>

        <!-- Apresentação: foto e número à esquerda; título, texto e botão à direita -->
        <section class="hero">
          <div class="hero__aside">
            {avatar && <Image class="hero__photo" src={avatar} alt={site.name} widths={[480]} sizes="140px" loading="eager" />}
            <p class="intro__stat">
              <span>{years}+</span>
              <small class="muted">anos de experiência</small>
            </p>
          </div>
          <div class="intro__main">
            <h1 class="hero__title">
              {cv.title.lead}<br /><span class="tone-2">{cv.title.rest}</span>
            </h1>
            <p class="intro__text">{noWidow(cv.intro)}</p>
            <!-- Botão para o portfólio digital (clicável no PDF) -->
            <a class="cta" href={portfolioUrl}>
              <span>Ver portfólio digital</span>
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </div>
        </section>

        <div class="body">
          <aside class="side">
            <div>
              <h2 class="eyebrow">{skills.label}</h2>
              <ul>{skills.items.map((i) => <li>{i}</li>)}</ul>
            </div>
            <div>
              <h2 class="eyebrow">{tools.label}</h2>
              <p class="side__inline">{tools.items.map((t) => t.replaceAll(' ', '\u00a0')).join('\u00a0· ')}</p>
            </div>
            <div>
              <h2 class="eyebrow">{ai.label}</h2>
              <ul>{ai.items.map((i) => <li>{i}</li>)}</ul>
            </div>
            <div>
              <h2 class="eyebrow">{languages.label}</h2>
              <ul>{languages.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          </aside>

          <div class="main">
            <section>
              <h2 class="eyebrow label">Experiência</h2>
              <ol>
                {
                  cv.experience.map((x) => (
                    <li class="row">
                      <div class="row__who">
                        <strong class="row__title">{x.company}</strong>
                        <span>{x.role}</span>
                        <span class="row__period">{x.period}</span>
                      </div>
                      <p class="row__text">{noWidow(x.description)}</p>
                    </li>
                  ))
                }
              </ol>
            </section>

            <section>
              <h2 class="eyebrow label">Formação</h2>
              <ol class="edu">
                {
                  cv.education.map((e) => (
                    <li class="edu__item">
                      <p class="edu__head">
                        <strong>{e.title}</strong>
                        <span class="row__period">{e.period}</span>
                      </p>
                      <p class="muted">{e.subtitle}</p>
                    </li>
                  ))
                }
              </ol>
            </section>
          </div>
        </div>
      </div>

      <!-- Faixa escura (rodapé do site): o link para o portfólio -->
      <footer class="end">
        <p class="end__title">{cv.footer.lead}<br /><span>{cv.footer.rest}</span></p>
        <div class="end__go">
          <a class="cta cta--light" href={portfolioUrl}>
            <span>Ver portfólio digital</span>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <span class="end__url">{pretty(portfolioUrl)}</span>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  body {
    margin: 0;
    background: #d6d5d0;
    color: var(--ink);
    font-family: var(--font);
    font-size: 8.2pt;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1,
  h2,
  p,
  ol,
  ul {
    margin: 0;
    padding: 0;
    font: inherit;
  }
  ul,
  ol {
    list-style: none;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  strong {
    font-weight: 500;
  }
  .muted {
    color: var(--ink-2);
  }
  .tone-2 {
    color: var(--ink-3);
  }
  .eyebrow {
    font-size: 6pt;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* Folha A4: papel claro com cantos inferiores arredondados sobre a faixa escura,
     o mesmo efeito do conteúdo do site subindo sobre o rodapé */
  .sheet {
    --side: 33mm; /* coluna lateral: foto, número e listas */
    --gap: 8mm;
    width: 210mm;
    height: 297mm;
    margin: 10mm auto;
    overflow: hidden;
    display: grid;
    grid-template-rows: 1fr auto;
    background: #121211;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.14);
  }
  @media print {
    body {
      background: none;
    }
    .sheet {
      margin: 0;
      box-shadow: none;
    }
  }
  .paper {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    padding: 8.5mm 14mm 7mm;
    background: var(--paper);
    border-radius: 0 0 7mm 7mm;
  }

  /* Topo */
  .top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 4mm;
  }
  .top__id {
    display: grid;
    line-height: 1.4;
  }
  .top__pill {
    padding: 1.5mm 4mm;
    border-radius: 99px;
    background: var(--ink);
    color: var(--paper);
    font-size: 7pt;
    font-weight: 500;
    line-height: 1.2;
  }
  .top__links {
    justify-self: end;
    display: grid;
    justify-items: end;
    line-height: 1.4;
  }
  .top__links a {
    background: linear-gradient(var(--ink-3), var(--ink-3)) 0 100% / 100% 0.5pt no-repeat;
  }

  /* Apresentação */
  .hero {
    display: grid;
    grid-template-columns: var(--side) 1fr;
    align-items: start;
    gap: var(--gap);
    padding: 6.5mm 0 5mm;
    border-bottom: 0.5pt solid var(--line);
  }
  .hero__aside {
    display: grid;
    gap: 5mm;
  }
  .hero__photo {
    display: block;
    width: var(--side);
    height: var(--side);
    object-fit: cover;
    border-radius: 6px;
  }
  .hero__title {
    font-size: 23pt;
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
    margin-top: -1.2mm;
  }

  .intro__stat {
    display: grid;
    line-height: 1;
  }
  .intro__stat span {
    font-size: 27pt;
    font-weight: 500;
    letter-spacing: -0.045em;
  }
  .intro__stat small {
    margin-top: 1.6mm;
    font-size: 7pt;
  }
  .intro__main {
    display: grid;
    justify-items: start;
    gap: 3.6mm;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 2.2mm;
    padding: 2.6mm 4.6mm 2.6mm 5.4mm;
    border-radius: 99px;
    background: var(--ink);
    color: var(--paper);
    font-size: 9.5pt;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .cta svg {
    width: 3.4mm;
    height: 3.4mm;
  }
  .intro__text {
    font-size: 9.8pt;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Corpo: lateral (listas) + principal (linhas), como na página About */
  .body {
    display: grid;
    grid-template-columns: var(--side) 1fr;
    gap: var(--gap);
    padding-top: 4.5mm;
  }
  .side {
    display: grid;
    align-content: start;
    gap: 4.4mm;
    font-size: 7.8pt;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .side .eyebrow {
    margin-bottom: 1.3mm;
  }
  .side__inline {
    line-height: 1.6;
  }
  .side li {
    text-wrap: pretty; /* itens longos quebram dentro da coluna */
    margin-bottom: 0.8mm;
  }

  .main {
    display: grid;
    align-content: start;
    gap: 4.5mm;
  }
  .label {
    padding-bottom: 1.8mm;
    border-bottom: 0.5pt solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 38mm 1fr;
    gap: 5mm;
    padding: 1.7mm 0 1.9mm;
    border-bottom: 0.5pt solid var(--line);
  }
  .row__title {
    font-size: 9pt;
    line-height: 1.35;
  }
  .row__who {
    display: grid;
    align-content: start;
    font-size: 7.4pt;
    line-height: 1.4;
  }
  .row__who .row__title {
    margin-bottom: 0.4mm;
  }
  .row__period {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .row__text {
    margin-top: 0.3mm;
    color: var(--ink-2);
    font-size: 7.8pt;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .edu {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gap);
  }
  .edu__item {
    padding: 1.8mm 0;
    border-bottom: 0.5pt solid var(--line);
  }
  .edu__head {
    display: flex;
    justify-content: space-between;
    gap: 3mm;
  }

  /* Faixa escura */
  .end {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 6mm;
    padding: 6mm 14mm 6.5mm;
    color: #f3f2ef;
  }
  .end__title {
    font-size: 19pt;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .end__title span {
    color: #8c8b85;
  }
  .end__go {
    display: grid;
    justify-items: end;
    gap: 2mm;
  }
  .end__url {
    font-size: 6.5pt;
    color: #8c8b85;
  }
  .cta--light {
    background: #f3f2ef;
    color: #121211;
  }
</style>

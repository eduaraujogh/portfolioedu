---
// Currículo em uma página A4, no estilo do site e com os mesmos dados (data/site.ts).
// Gera o PDF com: npm run curriculo  →  public/curriculo-eduardo-araujo.pdf
// Página fora do menu e fora dos buscadores; serve de fonte para o PDF.
// Estrutura espelha o site: faixa do header · frase em dois tons · lateral com listas +
// linhas de Experiência/Formação (About) · faixa escura no fim, como o rodapé.
import { Image } from 'astro:assets';
import { site, startYear } from '../data/site';
import '../styles/tokens.css';

const year = new Date().getFullYear();
const years = year - startYear;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const pretty = (url: string) => decodeURI(url).replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const { hero, about, aboutPage, experience, education } = site;
const [tools, ai, skills, languages] = aboutPage.side;
const social = (label: string) => site.socials.find((s) => s.label === label)!.href;

const contacts = [
  { label: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', href: social('LinkedIn') },
  { label: 'Behance', href: social('Behance') },
];

const avatars = import.meta.glob<{ default: ImageMetadata }>('../assets/me/avatar.{jpg,jpeg,png,webp}', { eager: true });
const avatar = Object.values(avatars)[0]?.default;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Currículo — {site.name}</title>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500&display=block" />
  </head>
  <body>
    <main class="sheet">
      <div class="paper">
        <!-- Faixa superior (header do site) -->
        <header class="top">
          <div class="top__id">
            <strong>{site.name}</strong>
            <span class="muted">{site.role} · {site.location}</span>
          </div>
          <span class="top__pill">Currículo</span>
          <ul class="top__links">
            {contacts.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          </ul>
        </header>

        <!-- Apresentação (hero do site) -->
        <section class="hero">
          {avatar && <Image class="hero__photo" src={avatar} alt={site.name} widths={[480]} sizes="140px" loading="eager" />}
          <h1 class="hero__title">
            {hero.lead} <span class="tone-2">{hero.rest}</span>
          </h1>
        </section>

        <section class="intro">
          <p class="intro__stat">
            <span>{years}+</span>
            <small class="muted">anos de experiência</small>
          </p>
          <p class="intro__text">{about.rest}</p>
        </section>

        <div class="body">
          <aside class="side">
            <div>
              <h2 class="eyebrow">{skills.label}</h2>
              <ul>{skills.items.map((i) => <li>{i}</li>)}</ul>
            </div>
            <div>
              <h2 class="eyebrow">{tools.label}</h2>
              <p>{tools.items.join(' · ')}</p>
            </div>
            <div>
              <h2 class="eyebrow">{ai.label}</h2>
              <p>{ai.items.join(' · ')}</p>
            </div>
            <div>
              <h2 class="eyebrow">{languages.label}</h2>
              <ul>{languages.items.map((i) => <li>{i.replace(' (em desenvolvimento)', '')}</li>)}</ul>
            </div>
            <div>
              <h2 class="eyebrow">Marcas atendidas</h2>
              <p>
                {about.brands.join(' · ')} <span class="muted">· {about.brandsMore}</span>
              </p>
            </div>
          </aside>

          <div class="main">
            <section>
              <h2 class="eyebrow label">{experience.label}</h2>
              <ol>
                {
                  experience.items.map((x) => (
                    <li class="row">
                      <strong class="row__title">{x.company}</strong>
                      <div class="row__body">
                        <p class="row__head">
                          <span>{x.role}</span>
                          <span class="row__period">{x.period}</span>
                        </p>
                        <p class="row__text">{x.description}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </section>

            <section>
              <h2 class="eyebrow label">{education.label}</h2>
              <ol class="edu">
                {
                  education.items.map((e) => (
                    <li class="edu__item">
                      <p class="edu__head">
                        <strong>{e.title}</strong>
                        <span class="row__period">{e.period}</span>
                      </p>
                      <p class="muted">{e.subtitle}</p>
                    </li>
                  ))
                }
              </ol>
            </section>
          </div>
        </div>
      </div>

      <!-- Faixa escura (rodapé do site): o link para o portfólio -->
      <footer class="end">
        <div class="end__cta">
          <p class="eyebrow">Portfólio completo</p>
          <a href={siteUrl}>{pretty(siteUrl)}<span aria-hidden="true"> ↗</span></a>
        </div>
        <div class="end__meta">
          <span>Portfólio {startYear} — {year}</span>
          <span>{site.footer.coords}</span>
        </div>
      </footer>
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  body {
    margin: 0;
    background: #d6d5d0;
    color: var(--ink);
    font-family: var(--font);
    font-size: 8.2pt;
    line-height: 1.45;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1,
  h2,
  p,
  ol,
  ul {
    margin: 0;
    padding: 0;
    font: inherit;
  }
  ul,
  ol {
    list-style: none;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  strong {
    font-weight: 500;
  }
  .muted {
    color: var(--ink-2);
  }
  .tone-2 {
    color: var(--ink-3);
  }
  .eyebrow {
    font-size: 6pt;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* Folha A4: papel claro com cantos inferiores arredondados sobre a faixa escura,
     o mesmo efeito do conteúdo do site subindo sobre o rodapé */
  .sheet {
    --side: 36mm; /* coluna lateral: foto, número e listas */
    --gap: 8mm;
    width: 210mm;
    height: 297mm;
    margin: 10mm auto;
    overflow: hidden;
    display: grid;
    grid-template-rows: 1fr auto;
    background: #121211;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.14);
  }
  @media print {
    body {
      background: none;
    }
    .sheet {
      margin: 0;
      box-shadow: none;
    }
  }
  .paper {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    padding: 11mm 14mm 10mm;
    background: var(--paper);
    border-radius: 0 0 7mm 7mm;
  }

  /* Topo */
  .top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 4mm;
  }
  .top__id {
    display: grid;
    line-height: 1.4;
  }
  .top__pill {
    padding: 1.5mm 4mm;
    border-radius: 99px;
    background: var(--ink);
    color: var(--paper);
    font-size: 7pt;
    font-weight: 500;
    line-height: 1.2;
  }
  .top__links {
    justify-self: end;
    display: grid;
    justify-items: end;
    line-height: 1.4;
  }
  .top__links a {
    background: linear-gradient(var(--ink-3), var(--ink-3)) 0 100% / 100% 0.5pt no-repeat;
  }

  /* Apresentação */
  .hero {
    display: grid;
    grid-template-columns: var(--side) 1fr;
    align-items: end;
    gap: var(--gap);
    padding-top: 12mm;
  }
  .hero__photo {
    display: block;
    width: var(--side);
    height: var(--side);
    object-fit: cover;
    border-radius: 6px;
  }
  .hero__title {
    font-size: 23pt;
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
    margin-bottom: -1mm;
  }

  .intro {
    display: grid;
    grid-template-columns: var(--side) 1fr;
    gap: var(--gap);
    align-items: start;
    padding: 7mm 0;
    border-bottom: 0.5pt solid var(--line);
  }
  .intro__stat {
    display: grid;
    line-height: 1;
  }
  .intro__stat span {
    font-size: 27pt;
    font-weight: 500;
    letter-spacing: -0.045em;
  }
  .intro__stat small {
    margin-top: 1.6mm;
    font-size: 7pt;
  }
  .intro__text {
    font-size: 9.8pt;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  /* Corpo: lateral (listas) + principal (linhas), como na página About */
  .body {
    display: grid;
    grid-template-columns: var(--side) 1fr;
    gap: var(--gap);
    padding-top: 6.5mm;
  }
  .side {
    display: grid;
    align-content: start;
    gap: 4.4mm;
    font-size: 7.8pt;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .side .eyebrow {
    margin-bottom: 1.3mm;
  }

  .main {
    display: grid;
    align-content: start;
    gap: 7mm;
  }
  .label {
    padding-bottom: 1.8mm;
    border-bottom: 0.5pt solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 30mm 1fr;
    gap: 4mm;
    padding: 2.4mm 0 2.6mm;
    border-bottom: 0.5pt solid var(--line);
  }
  .row__title {
    font-size: 9pt;
    line-height: 1.35;
  }
  .row__head {
    display: flex;
    justify-content: space-between;
    gap: 3mm;
  }
  .row__period {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .row__text {
    margin-top: 0.9mm;
    color: var(--ink-2);
    font-size: 7.8pt;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .edu {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--gap);
  }
  .edu__item {
    padding: 2.2mm 0;
    border-bottom: 0.5pt solid var(--line);
  }
  .edu__head {
    display: flex;
    justify-content: space-between;
    gap: 3mm;
  }

  /* Faixa escura */
  .end {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 6mm;
    padding: 7mm 14mm 8mm;
    color: #f3f2ef;
  }
  .end .eyebrow {
    color: #8c8b85;
    margin-bottom: 1.6mm;
  }
  .end__cta a {
    font-size: 16pt;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }
  .end__cta a span {
    color: #8c8b85;
  }
  .end__meta {
    display: grid;
    justify-items: end;
    font-size: 7pt;
    line-height: 1.5;
    color: #8c8b85;
  }
</style>
